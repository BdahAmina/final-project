# Copy to .env inside medical_visit_mvp (never commit .env). All values are optional unless noted.

# Local model server used for extraction, summaries and the clinical assistant (no cloud provider is used).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional local speaker diarization (pyannote.audio); needs a Hugging Face token that accepted the model terms.
HF_TOKEN=

# Strongly recommended: secret key for the audit-trail HMAC chain. Keep it outside the database folder and
# its backups (for example in a password manager). Generate one with:
#   ..\venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=

# Security policy (defaults shown)
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8
PASSWORD_MAX_AGE_DAYS=180

# Retention of temporary audio and pseudonym mappings, in hours
TMP_AUDIO_RETENTION_HOURS=24

# Optional: TTF font for Hebrew/Arabic PDF export (defaults to Arial on Windows)
EXPORT_FONT=
